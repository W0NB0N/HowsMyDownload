[Unit]
Description=Download Notifs Production Backend Service
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/notifs/deploy
EnvironmentFile=/opt/notifs/deploy/.env

# Run via Docker Compose for isolated container execution
ExecStartPre=-/usr/bin/docker compose -f /opt/notifs/deploy/docker-compose.yml down
ExecStart=/usr/bin/docker compose -f /opt/notifs/deploy/docker-compose.yml up
ExecStop=/usr/bin/docker compose -f /opt/notifs/deploy/docker-compose.yml down

Restart=always
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=30s

# Sandboxing and Resource Limits
LimitNOFILE=65536
LimitNPROC=4096

# Standard Output / Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=notifs-api

[Install]
WantedBy=multi-user.target
