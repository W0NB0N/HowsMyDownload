# ==========================================================
# Download Notifs — Production Environment Configuration (.env)
# ==========================================================

# Pairing Storage Provider:
# - 'firestore': Production database backed by Google Cloud Firestore. The server
#   refuses to start if Firestore cannot be initialized (no silent fallback).
# - 'memory': In-memory RAM storage with auto-expiration (local dev / single node).
STORE_TYPE=firestore

# Push Notification Provider:
# - 'fcm': Firebase Cloud Messaging high-priority data messages to mobile devices.
# - 'console': Terminal stdout logger.
# - 'both': Console logging + FCM push concurrently.
NOTIFIER_TYPE=fcm

# Path to Firebase Service Account Credentials JSON (inside Docker container):
GOOGLE_APPLICATION_CREDENTIALS=/app/service-account.json

# Server Network Configuration:
HOST=0.0.0.0
PORT=8000

# Authentication is always enforced: samples require the extension's bearer secret, and
# token refresh / unpair require the extension or device secret. There is no bypass flag.
