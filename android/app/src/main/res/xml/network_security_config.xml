<?xml version="1.0" encoding="utf-8"?>
<!-- Release: HTTPS only, system CAs only. Debug builds override this file
     (src/debug/res/xml) to allow localhost / LAN HTTP and user CAs for proxy debugging. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
